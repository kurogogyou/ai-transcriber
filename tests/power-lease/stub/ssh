#!/usr/bin/env bash
# Stub ssh for the power-lease tests. Decides by looking at the whole arg list.
args="$*"

case "$args" in
    *"-O exit"*)                         exit 0 ;;                       # closing the tunnel master
    *"-f -N -M"*)                        exit "${STUB_TUNNEL_RC:-0}" ;;  # opening the tunnel
    *"systemctl poweroff"*)              echo "$args" >> "$STUB_LOG/poweroff"; exit 0 ;;
    *"boot_id"*)                         echo "${STUB_BOOT_ID:?}"; exit 0 ;;
    *" true"|*" true "*)                 [ "${STUB_HOST_UP:-0}" = 1 ] && exit 0 || exit 255 ;;
esac
echo "stub ssh: unhandled args: $args" >&2
exit 1
